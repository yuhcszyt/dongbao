# 知识库 MCP —— 复制成 .env 再填 key
# tokenhub 的 key 与 hindsight 用的是同一个

EMBEDDING_BASE_URL=https://tokenhub.tencentmaas.com/v1
EMBEDDING_MODEL=kinfra-text-embedding-0.6b
EMBEDDING_API_KEY=

# 不上鉴权就留空（仅 Tailscale 内网可用）
QDRANT_API_KEY=

# 上服务器后改成 Tailscale IP，让 Mac / Windows / 家庭机都能连
# QDRANT_BIND=100.x.x.x
# KB_BIND=100.x.x.x

# 端口与切分
KB_PORT=8800
CHUNK_CHARS=1000
DEFAULT_COLLECTION=kb-docs
ALLOWED_COLLECTIONS=kb-docs,kb-code,kb-ops
