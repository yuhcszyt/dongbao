POSTGRES_DB=dongbao
POSTGRES_USER=dongbao
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://dongbao:change-me@postgres:5432/dongbao
CLIENT_API_BASE_URL=http://localhost:8000/api/v1
# 体验版 / 生产：打小程序包时用 HTTPS，例如 https://api.example.com/api/v1
# VITE_API_BASE_URL=https://api.example.com/api/v1
# 生产 compose：deploy/docker-compose.prod.yml 需要 DOMAIN=api.example.com
# DOMAIN=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
MODEL_API_KEY=
EMBEDDING_API_KEY=
QDRANT_URL=http://127.0.0.1:6333

# 登录：真实微信小程序凭证（与 apps/client/src/manifest.json 的 mp-weixin.appid 一致）。
# 未填且未开开发降级时，登录返回 502 wechat_login_failed。
WECHAT_APPID=
WECHAT_SECRET=
# JWT 签名密钥：默认是开发值 dongbao-dev-secret，生产必须覆盖。
JWT_SECRET=
# 开发降级：仅 H5 / CI 显式设为 1（跳过 jscode2session，任意 code 都能登录）。
# 验真机小程序时必须留空，否则 wx.login 每次新 code 会被当成新 openid。
# 启动日志会打印当前处于哪种模式。生产禁止设置。
DEV_LOGIN=
