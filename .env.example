CLIENT_API_BASE_URL=http://localhost:8000/api/v1
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
MODEL_API_KEY=

# 登录：真实微信凭证（生产必填）。未填且未开开发降级时，登录返回 502 wechat_login_failed。
