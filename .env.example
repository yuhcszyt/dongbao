WECHAT_SECRET=
# JWT 签名密钥：默认是开发值 dongbao-dev-secret，生产必须覆盖。
JWT_SECRET=
# 开发降级：仅本地/CI 显式设为 1（跳过 jscode2session，任意 code 都能登录）；生产禁止设置。
# 启动日志会打印当前处于哪种模式。
DEV_LOGIN=
